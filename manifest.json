{
  "manifest_version": 2,
  "name": "Container Home",
  "version": "0.1.0",
  "description": "Open a configured home URL for the current Firefox container.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "contextualIdentities"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "commands": {
    "open-container-home": {
      "suggested_key": {
        "default": "Alt+Shift+Home"
      },
      "description": "Open the home URL for the current container"
    }
  }
}
